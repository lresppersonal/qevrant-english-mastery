# --- Supabase (EU region project) ---
# Leave both empty to run in Demo mode (data stays in the browser, no sign-in).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Show the "Continue with Google" button. Only set to true after enabling Google in
# Supabase → Authentication → Providers (see docs/LAUNCH-GUIDE.md). Users always sign in on
# Google's own page; the app never sees their Google password.
NEXT_PUBLIC_AUTH_GOOGLE=false

# --- AI practice feedback (server only, never exposed to the browser) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: server-side speech-to-text. Without it, speaking uses the browser's speech recognition.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Max AI analyses per learner per day (writing + speaking combined)
AI_DAILY_LIMIT=20
# Demo mode only: allow AI calls without sign-in (local development). Never set in production.
AI_DEMO_ALLOW=false
