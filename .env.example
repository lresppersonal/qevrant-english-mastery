# --- Supabase (EU region project) ---
# Leave both empty to run in Demo mode (data stays in the browser, no sign-in).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Show the "Continue with Google" button. Only set to true after enabling Google in
# Supabase → Authentication → Providers (see docs/LAUNCH-GUIDE.md). Users always sign in on
# Google's own page; the app never sees their Google password.
NEXT_PUBLIC_AUTH_GOOGLE=false

# --- AI practice feedback (server only, never exposed to the browser) ---
# --- AI: open model via Hugging Face (free monthly credits) — see docs/OPEN-MODEL.md ---
AI_PROVIDER=huggingface
HF_TOKEN=
# Any model on the Hugging Face router, or your own fine-tuned model (with AI_BASE_URL)
AI_OPEN_MODEL=openai/gpt-oss-120b:cheapest
# AI_OPEN_FAST_MODEL=
# AI_BASE_URL=https://router.huggingface.co/v1
# --- or Claude instead ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: server-side speech-to-text. Without it, speaking uses the browser's speech recognition.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Max AI analyses per learner per day (writing + speaking combined)
AI_DAILY_LIMIT=20
# Demo mode only: allow AI calls without sign-in (local development). Never set in production.
AI_DEMO_ALLOW=false

# --- Dictionary ---
# Free Dictionary API (Wiktionary data, no key needed). Override only for testing.
# DICTIONARY_API_BASE=https://api.dictionaryapi.dev/api/v2/entries/en
# Fast model used to write dictionary entries (Russian, definitions, meaning in context).
DICTIONARY_AI_MODEL=claude-haiku-5-5
# AI "Why doesn't my answer fit?" explanations per learner per day
EXPLAIN_DAILY_LIMIT=150
# Max AI-written dictionary entries per learner per day (cached and built-in words are unlimited).
DICTIONARY_AI_DAILY_LIMIT=300
# Optional, SERVER-ONLY (never prefix with NEXT_PUBLIC_): lets the server save dictionary entries
# to the shared cache table so every learner gets them instantly. Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: natural UK/US neural voices when a word has no human recording (Google Cloud Text-to-Speech).
GOOGLE_TTS_API_KEY=
